# Server-side only — never prefix with NEXT_PUBLIC_, never referenced from client components.

# Base URL of the FastAPI backend (Render web service), no trailing slash.
BACKEND_URL=https://recall-backend.onrender.com

# Shared secret presented by the extension as a Bearer token, and forwarded
# by this app to the backend as the same Bearer token.
BACKEND_AUTH_TOKEN=change-me

# Single-user dashboard password (FR18).
DASHBOARD_PASSWORD=change-me

# Secret used to HMAC-sign the dashboard session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# Optional — Sentry error tracking (free tier). Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
